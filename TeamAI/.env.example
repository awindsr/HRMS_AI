# TeamAI (backend) — required configuration. COPY, don't commit real values.
#
# This file is the onboarding contract: every variable the backend needs to run.
# It contains NO real values. For LOCAL dev prefer .NET User Secrets; in CI/prod
# set these as environment variables. Both bind to the same config keys.
#
# Binding: ASP.NET Core maps the "__" (double underscore) delimiter to the ":" config
# path, so Agent__ApiKey  ->  Configuration["Agent:ApiKey"]  ->  AgentOptions.ApiKey.
# Precedence (Development): appsettings.json < appsettings.Development.json < User Secrets < environment variables.
#
# --- LOCAL DEV (recommended): .NET User Secrets, not env vars ---
#   cd TeamAI
#   dotnet user-secrets set "Agent:ApiKey"   "<foundry-resource-api-key>"
#
# --- CI / PRODUCTION: environment variables (or Azure Key Vault via KeyVault__Uri) ---

# Non-secret — the Foundry resource's OpenAI v1 endpoint the chat relay calls.
Agent__Endpoint=https://<resource>.services.ai.azure.com/openai/v1
# Non-secret — the deployed model name (Build -> Deployments).
Agent__ModelDeploymentName=gpt-4.1-mini

# SECRET — Foundry resource API key. When set, it authenticates the model calls. Prefer User
# Secrets / env vars; never commit it. Leave empty to use the Entra ID fallback below.
Agent__ApiKey=

# Entra ID fallback (used only when Agent__ApiKey is empty).
# SECRET — Entra (Azure AD) tenant id of the Foundry resource.
Agent__TenantId=
# Dev only: interactive browser sign-in (handles MFA). Leave false in prod (managed identity).
Agent__InteractiveLogin=true

# Optional — production secret store. When set in Production, non-secret upstream settings
# are sourced from Azure Key Vault via DefaultAzureCredential. Leave empty for local/dev.
KeyVault__Uri=

# Non-secret upstream (HRMS) settings — config, NOT secrets. Defaults live in appsettings.json;
# override here only for a different environment. The per-user HRMS bearer token is NEVER
# configured: it is supplied at login and stored in the encrypted httpOnly session cookie.
# This is an individual-user assistant — there is no team id.
Hrms__BaseUrl=https://localhost:44360
